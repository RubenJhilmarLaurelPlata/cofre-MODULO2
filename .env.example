# Copia este archivo a .env antes de correr el proyecto:
#   cp .env.example .env

# Base de datos (SQLite por defecto — el archivo se crea solo).
# Para migrar a PostgreSQL en el futuro, cambia el provider en
# prisma/schema.prisma a "postgresql" y pon aquí la cadena de conexión.
#
# "?connection_limit=1" es OBLIGATORIO con SQLite (no con PostgreSQL):
# fuerza a Prisma a serializar las escrituras en su propia cola en vez de
# abrir varias conexiones que compitan por el unico lock de escritura de
# SQLite. Sin esto, rafagas de escaneos realmente simultaneos (mas de un
# lector escribiendo en el mismo instante) pueden agotar el tiempo de
# espera y devolver error 500 en vez de encolarse — verificado con una
# prueba real de 20 escrituras concurrentes.
DATABASE_URL="file:./dev.db?connection_limit=1"

# Secreto para firmar los tokens de sesión (JWT). Genera uno propio y
# largo para producción, por ejemplo con: openssl rand -hex 32
JWT_SECRET="cambia-este-valor-por-uno-propio-y-largo-en-produccion"

# Nombre del entorno (development | production)
NODE_ENV="development"

# Zona horaria del proceso Node. TODO el sistema (dias cobrables en
# pricing.ts, "hoy/ayer/esta semana" en reportes.ts/dashboard-data.ts,
# generacion de etiquetas) calcula "medianoche" con metodos de Date
# nativos (getFullYear/getMonth/getDate/getDay/setHours), que dependen
# por completo de esta variable — nunca del campo "Zona horaria" que se
# ve en Configuracion > Preferencias (ese campo es solo informativo, no
# se lee en ningun calculo de fecha). Si el sistema operativo del
# servidor no esta en America/La_Paz (ej. una VPS que por defecto viene
# en UTC), un paquete que ingresa despues de las 20:00 hora Bolivia
# (=00:00 UTC del dia siguiente) se contaria como si hubiera ingresado
# un dia despues, y los domingos/feriados podrian evaluarse mal cerca de
# esa misma franja horaria — confirmado de forma aislada (sin tocar la
# base de datos) comparando dateKey() de un mismo instante real bajo
# TZ=America/La_Paz vs TZ=UTC. next.config.mjs ya fuerza este mismo valor
# por defecto si no esta seteado, pero se documenta aqui para que quede
# explicito y sea facil de verificar/cambiar.
TZ="America/La_Paz"
